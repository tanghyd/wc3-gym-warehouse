# Copy to .env. Compose and the justfile both read it. Never commit .env.
# These values run the local stack: MinIO stands in for R2 and holds the goldens.
# For the box, copy it to .env.box (git-ignored) instead and follow docs/deploy.md.

# `local` adds MinIO. Empty on the box, where the bucket is R2; `tunnel` adds the
# Cloudflare Tunnel once a domain exists.
COMPOSE_PROFILES=local

# The box, as user@host, for the `just deploy *` recipes on your machine. Not read on the box.
BOX_SSH=

# Password for the ClickHouse `default` user (dbt). Empty locally, set on the box.
CLICKHOUSE_PASSWORD=
# Password for the read-only `api` user the query API connects as.
CLICKHOUSE_API_PASSWORD=
# Password for the read-only `grafana` user Grafana connects as.
CLICKHOUSE_GRAFANA_PASSWORD=
# Password for the `ingest` user the drain inserts as (SELECT and INSERT on ingest.* only).
CLICKHOUSE_INGEST_PASSWORD=

# The bucket the drain reads. It lists <prefix>/replays/ and never writes there.
# The S3 endpoint as host:port. R2 is <account id>.r2.cloudflarestorage.com.
W3WAREHOUSE_S3_ENDPOINT=minio:9000
# true for R2 and any other https endpoint, false for a local MinIO.
W3WAREHOUSE_S3_SECURE=false
# R2 has two keys, and only the drain's belongs here: an R2 API token scoped to this
# bucket with Object Read only. The uploader (the GNL backend, wc3-gym-backend) holds
# the only write key; it never goes on the box. This is the read-only token's access
# key id, or locally the MinIO root user, which `just local::upload-replays` and
# `just local::mc` also use.
W3WAREHOUSE_S3_ACCESS_KEY=minioadmin
# The matching secret access key, or the MinIO root password.
W3WAREHOUSE_S3_SECRET_KEY=minioadmin
# The bucket holding replays/.
W3WAREHOUSE_S3_BUCKET=warehouse
# The leading key segment. The GNL backend keys every object under its Vercel
# environment (wc3-gym-backend app/services/r2.py): production, preview or development.
W3WAREHOUSE_S3_PREFIX=preview

# A second read-only source, such as W3Champions' bucket: setting the bucket turns it on.
# The drain lists <prefix>/ as given (no replays/ added) with a read-only key.
W3WAREHOUSE_SOURCE2_BUCKET=
W3WAREHOUSE_SOURCE2_ENDPOINT=
W3WAREHOUSE_SOURCE2_SECURE=true
W3WAREHOUSE_SOURCE2_ACCESS_KEY=
W3WAREHOUSE_SOURCE2_SECRET_KEY=
W3WAREHOUSE_SOURCE2_PREFIX=

# Cloudflare Tunnel token, from the tunnel's dashboard page. Only the tunnel profile reads it.
TUNNEL_TOKEN=
