# Copy to .env. Compose and the justfile both read it. Never commit .env.
# These values run the local stack: MinIO stands in for R2 and holds the goldens.

# `local` adds MinIO. Leave it out when the bucket is R2.
COMPOSE_PROFILES=local

# Password for the ClickHouse `default` user (dbt). Empty locally, set on the box.
CLICKHOUSE_PASSWORD=
# Password for the read-only `api` user the query API connects as.
CLICKHOUSE_API_PASSWORD=
# Password for the read-only `grafana` user Grafana connects as.
CLICKHOUSE_GRAFANA_PASSWORD=

# The S3 endpoint as host:port. R2 is <account id>.r2.cloudflarestorage.com.
W3WAREHOUSE_S3_ENDPOINT=minio:9000
# true for R2 and any other https endpoint, false for a local MinIO.
W3WAREHOUSE_S3_SECURE=false
# R2 access key id, or the MinIO root user.
W3WAREHOUSE_S3_ACCESS_KEY=minioadmin
# R2 secret access key, or the MinIO root password.
W3WAREHOUSE_S3_SECRET_KEY=minioadmin
# The bucket holding replays/, parsed/ and status/.
W3WAREHOUSE_S3_BUCKET=warehouse
# The leading key segment. The GNL backend keys every object under its Vercel
# environment (wc3-gym-backend app/services/r2.py): production, preview or development.
W3WAREHOUSE_S3_PREFIX=preview
# The parsed docs dbt loads: scheme, endpoint, bucket, prefix, then parsed/v<PARSE_VERSION>/.
# R2: https://<account id>.r2.cloudflarestorage.com/<bucket>/production/parsed/v3/**.json
W3WAREHOUSE_PARSED_URL=http://minio:9000/warehouse/preview/parsed/v3/**.json
# How long the drain waits between passes, in milliseconds.
WORKER_POLL_MS=60000

# Cloudflare Tunnel token, from the tunnel's dashboard page. Only the prod profile.
TUNNEL_TOKEN=
