# Cloudflare Tunnel ingress. Copy to config.yml on the box, or skip the file
# entirely and give the container a TUNNEL_TOKEN from a dashboard-managed tunnel
# with the same one route.
#
# The replay inspector is the only thing behind the tunnel. The API and ClickHouse
# stay private: the inspector's server side reads the API at http://api:8000 over
# the compose network. No port is open on the box.
tunnel: <tunnel id>
credentials-file: /etc/cloudflared/<tunnel id>.json

ingress:
  - hostname: warehouse.<domain>
    service: http://web:3000
  - service: http_status:404
