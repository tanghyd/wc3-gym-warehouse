# Cloudflare Tunnel. The compose `tunnel` profile runs cloudflared in token mode: make a
# tunnel in the Cloudflare dashboard, give it one public hostname routed to
# http://web:3000, and put its token in .env as TUNNEL_TOKEN. No file is mounted.
#
# The replay inspector is the only thing behind the tunnel. The API and ClickHouse
# stay on the compose network; the inspector's server side reads the API there.
# This file is the equivalent ingress for a file-managed tunnel, for reference only.
ingress:
  - hostname: warehouse.<domain>
    service: http://web:3000
  - service: http_status:404
