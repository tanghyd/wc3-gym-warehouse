<?xml version="1.0"?>
<!--
  Template for the local clickhouse-server config. server.sh renders the
  runtime config.xml from this file with `envsubst`, substituting two paths:
    ${W3W_WAREHOUSE_ROOT} — the warehouse root (file() chroot for the loader).
    ${W3W_STATE_DIR}      — engine state, OUTSIDE the repo tree
                         ($XDG_STATE_HOME/w3warehouse/clickhouse-local/).
  users.xml resolves relative to the rendered config (both in config/).
  Listens on 127.0.0.1 only.

  Scope: this is the batch-load + query dev engine. It deliberately omits a
  <keeper_server>/<zookeeper> block, so the S3Queue stream path
  (db/w3g/stream.sql) CANNOT run here — S3Queue keeps its consumed-key
  watermark in Keeper. The stream path is a Docker `stream`-profile feature
  (Keeper via infrastructure/docker/clickhouse/keeper.xml; its MinIO endpoint
  resolves only inside the compose network). The host and Docker CH configs
  are intentionally scoped to different jobs, not two copies meant to converge.
-->
<clickhouse>
    <logger>
        <level>information</level>
        <log>${W3W_STATE_DIR}/logs/clickhouse-server.log</log>
        <errorlog>${W3W_STATE_DIR}/logs/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
        <console>1</console>
    </logger>

    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <listen_host>127.0.0.1</listen_host>

    <max_connections>64</max_connections>
    <keep_alive_timeout>3</keep_alive_timeout>
    <max_concurrent_queries>32</max_concurrent_queries>

    <path>${W3W_STATE_DIR}/data/</path>
    <tmp_path>${W3W_STATE_DIR}/tmp/</tmp_path>
    <!-- file() is chrooted to user_files_path. server.sh substitutes the absolute warehouse root. -->
    <user_files_path>${W3W_WAREHOUSE_ROOT}/</user_files_path>
    <format_schema_path>${W3W_STATE_DIR}/format_schemas/</format_schema_path>

    <users_config>users.xml</users_config>
    <default_profile>default</default_profile>
    <default_database>default</default_database>

    <mark_cache_size>536870912</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <timezone>UTC</timezone>

    <mlock_executable>false</mlock_executable>
</clickhouse>
