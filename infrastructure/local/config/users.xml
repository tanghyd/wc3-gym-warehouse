<?xml version="1.0"?>
<!--
  Local-only users config: default user has no password and is restricted
  to loopback. Do not expose this server beyond 127.0.0.1.
-->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>4000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
            <!-- w3g.refresh__opener_rollup is a refreshable MV, opt-in on 24.x. -->
            <allow_experimental_refreshable_materialized_view>1</allow_experimental_refreshable_materialized_view>
        </default>
    </profiles>

    <users>
        <default>
            <password></password>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
