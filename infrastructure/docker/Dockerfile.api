# The query API. Tests run in this image too (`just api-test`), so it keeps the dev group.
FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /bin/uv
WORKDIR /api
ENV UV_PROJECT_ENVIRONMENT=/venv
COPY api/pyproject.toml api/uv.lock ./
RUN uv sync --frozen
COPY api/ ./
# --root-path: nginx serves the API under /api/, so /docs must fetch /api/openapi.json.
CMD ["uv", "run", "--frozen", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--root-path", "/api"]
