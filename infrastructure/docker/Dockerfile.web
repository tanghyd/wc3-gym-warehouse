# The replay inspector (web/), built to Next's standalone server.
FROM node:22-slim AS deps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./

# `just local::web-lint`
FROM deps AS lint
RUN pnpm lint

FROM deps AS build
RUN pnpm build

FROM node:22-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /web
COPY --from=build /web/.next/standalone ./
COPY --from=build /web/.next/static ./.next/static
# The object and race icons come from frontend/, so git holds them once.
COPY frontend/icons.json ./public/icons.json
COPY frontend/icons ./public/icons
COPY frontend/race-icons ./public/race-icons
USER node
EXPOSE 3000
CMD ["node", "server.js"]
