# The parse drain. Each run lists the source buckets' replay prefixes, parses each
# new or changed .w3g via w3grs, and inserts the documents into ClickHouse's
# ingest tables. Run one at a time: `just local::ingest` or `just local::drain-once`.
#
# All three bins ship: `drain` is one pass, `parse` and `export-mappings` are
# one-shot tools run with `docker compose run`.
#
# Builder pinned to -bookworm so its glibc matches the debian:bookworm-slim
# runtime (a newer rust:1-slim tracks trixie/glibc 2.38 and the binary won't load).
FROM rust:1-slim-bookworm AS build
WORKDIR /build
COPY pipeline/parse-rs ./pipeline/parse-rs
RUN cargo build --release --manifest-path pipeline/parse-rs/Cargo.toml

# `just local::drain-test`: the unit tests and parser goldens on the compiled deps above.
FROM build AS test
RUN cargo test --release --manifest-path pipeline/parse-rs/Cargo.toml

FROM debian:bookworm-slim
# ca-certificates is for TLS to R2 in production; local MinIO and ClickHouse are plain http.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/pipeline/parse-rs/target/release/drain /usr/local/bin/drain
COPY --from=build /build/pipeline/parse-rs/target/release/parse /usr/local/bin/parse
COPY --from=build /build/pipeline/parse-rs/target/release/export-mappings /usr/local/bin/export-mappings

# One pass over every source, then exit.
CMD ["drain", "--once"]
