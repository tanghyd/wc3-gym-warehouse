<?xml version="1.0"?>
<!--
  Single-node tuning: ClickHouse shares the machine with the drain, the API, the
  inspector and Grafana. The image defaults assume it owns the whole machine.
  (metric-log.xml enables the metric_log tables; this file bounds memory and the
  on-by-default system logs.)
-->
<clickhouse>
    <!-- compose.yaml caps the container at 3 GiB (measured 1.11 GiB resident, 1.68 GiB
         peak). 2.5 GiB leaves the rest for memory the server does not track, so a big
         query fails with MEMORY_LIMIT_EXCEEDED before the kernel kills the server.
         Per-query caps live in the api and grafana profiles (users.xml). -->
    <max_server_memory_usage>2684354560</max_server_memory_usage>

    <!-- Server-side query cache, off unless a query sets use_query_cache. Bound
         it so cached results cannot crowd query memory on a shared machine. -->
    <query_cache>
        <max_size_in_bytes>268435456</max_size_in_bytes>  <!-- 256 MiB -->
    </query_cache>

    <!-- System logs grow with uptime, not data, so bound them. query_log feeds
         Grafana's Query API and Warehouse data dashboards (14 days); trace_log and
         part_log are for debugging (7 days). metric-log.xml bounds metric_log and
         asynchronous_metric_log. -->
    <query_log replace="1">
        <database>system</database><table>query_log</table>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </query_log>
    <trace_log replace="1">
        <database>system</database><table>trace_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </trace_log>
    <part_log replace="1">
        <database>system</database><table>part_log</table>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
</clickhouse>
