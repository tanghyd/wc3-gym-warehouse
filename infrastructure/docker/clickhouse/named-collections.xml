<?xml version="1.0"?>
<!--
  The parsed replay documents dbt loads (dbt/models/landing/raw_replays.sql reads
  s3(parsed_docs, ...)). The URL glob and the keys come from the container's
  environment, so they never appear in SQL, dbt's compiled output or query_log.
-->
<clickhouse>
    <named_collections>
        <parsed_docs>
            <url from_env="W3WAREHOUSE_PARSED_URL"/>
            <access_key_id from_env="W3WAREHOUSE_S3_ACCESS_KEY"/>
            <secret_access_key from_env="W3WAREHOUSE_S3_SECRET_KEY"/>
        </parsed_docs>
    </named_collections>
</clickhouse>
