<?xml version="1.0"?>
<!--
  default: dbt's user. It may read the parsed_docs named collection.
  api: the query API's user. Read only, the w3g database only, with a time and
  memory cap per query so one bad filter cannot starve the server.
  grafana: Grafana's user. Read only, w3g and the system tables its dashboards
  read, with the same caps.
-->
<clickhouse>
    <users>
        <default>
            <named_collection_control>1</named_collection_control>
        </default>
        <api>
            <password from_env="CLICKHOUSE_API_PASSWORD"/>
            <profile>api</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <allow_databases><database>w3g</database></allow_databases>
        </api>
        <grafana>
            <password from_env="CLICKHOUSE_GRAFANA_PASSWORD"/>
            <profile>grafana</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON w3g.*</query>
                <query>GRANT SELECT ON system.query_log</query>
                <query>GRANT SELECT ON system.metric_log</query>
                <query>GRANT SELECT ON system.asynchronous_metric_log</query>
                <query>GRANT SELECT ON system.parts</query>
            </grants>
        </grafana>
    </users>
    <profiles>
        <api>
            <readonly>1</readonly>
            <max_execution_time>10</max_execution_time>
            <max_memory_usage>2000000000</max_memory_usage>
            <!-- count() is UInt64; answer it as a JSON number, not a string -->
            <output_format_json_quote_64bit_integers>0</output_format_json_quote_64bit_integers>
        </api>
        <grafana>
            <readonly>1</readonly>
            <max_execution_time>10</max_execution_time>
            <max_memory_usage>2000000000</max_memory_usage>
            <!-- The plugin's driver sends max_execution_time with every query;
                 readonly=1 refuses any setting unless a constraint allows it. -->
            <constraints>
                <max_execution_time>
                    <max>10</max>
                    <changeable_in_readonly/>
                </max_execution_time>
            </constraints>
        </grafana>
    </profiles>
</clickhouse>
